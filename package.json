{
  "name": "soroban-events",
  "version": "3.0.0",
  "description": "Resilient, windowed event streamer and XDR decoder for Soroban RPC",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:live": "node tests/test-engine.js",
    "pack:check": "npm pack --dry-run",
    "cli": "node src/cli.js",
    "test:unit": "node --test tests/*.test.js",
    "audit": "node scripts/audit.mjs",
    "pack:audit": "node scripts/pack-audit.mjs",
    "test:pack": "node --test tests/packed-consumer.test.js",
    "test:release": "npm test && npm run test:pack && npm pack --dry-run && git diff --check"
  },
  "keywords": [
    "soroban",
    "stellar",
    "events",
    "event-streaming",
    "event-indexer",
    "xdr",
    "rpc",
    "soroban-rpc",
    "blockchain-events",
    "event-replay",
    "event-backfill"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.1.0"
  },
  "bin": {
    "soroban-events": "./src/cli.js"
  },
  "types": "./src/index.d.ts"
}
